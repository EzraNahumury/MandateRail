# Copy to .env.local and fill DAML_PACKAGE_ID.
JSON_API_URL=http://localhost:7575
LEDGER_SECRET=secret
LEDGER_ID=sandbox
APPLICATION_ID=mandaterail
# Main package id of the mandaterail DAR. REGENERATE after any Daml change
# (the package id is part of every template id):
#   daml damlc inspect-dar --json ../.daml/dist/mandaterail-1.0.0.dar
#   -> copy "main_package_id" here.
DAML_PACKAGE_ID=

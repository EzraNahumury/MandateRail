# Daml HTTP JSON API base URL (default from `daml start`).
LEDGER_URL=http://localhost:7575

# Application id stamped into the dev tokens.
APPLICATION_ID=mandaterail

# HS256 secret for dev tokens. The signature is NOT verified when the sandbox
# runs unauthenticated (the default for `daml start`), so any value works.
LEDGER_SECRET=secret

# Ledger id claim. `daml start` (Canton sandbox) REQUIRES this; its default is
# "sandbox" (also the agent's built-in default, so you can leave this unset).
LEDGER_ID=sandbox

# Optional: enables the REAL Claude reasoning step (agent/src/reasoner.ts). The
# model only chooses among quotes the ledger has ALREADY deemed compliant, and its
# output is whitelist-validated; it has ZERO enforcement authority — the ledger is
# the only trust anchor. Omit to run fully deterministic (cheapest-compliant).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM_TIMEOUT_MS=30000

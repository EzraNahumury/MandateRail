# Daml HTTP JSON API base URL (default from `daml start`).
LEDGER_URL=http://localhost:7575

# Application id stamped into the dev tokens.
APPLICATION_ID=mandaterail

# HS256 secret for dev tokens. The signature is NOT verified when the sandbox
# runs unauthenticated (the default for `daml start`), so any value works.
LEDGER_SECRET=secret

# Ledger id claim. `daml start` (Canton sandbox) REQUIRES this; its default is
# "sandbox" (also the agent's built-in default, so you can leave this unset).
LEDGER_ID=sandbox

# Optional: enables the REAL model reasoning step (agent/src/reasoner.ts) via
# Ollama Cloud. The model only chooses among quotes the ledger has ALREADY deemed
# compliant, and its output is whitelist-validated; it has ZERO enforcement
# authority — the ledger is the only trust anchor. Omit OLLAMA_KEY to run fully
# deterministic (cheapest-compliant). Copy this file to .env and fill in your key.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_KEY=your-ollama-cloud-key
# OLLAMA_MODEL=gpt-oss:120b-cloud
# LLM_TIMEOUT_MS=30000

module MandateRail.Charter where

import MandateRail.Mandate

-- | The governance moment made visible. Instead of the CEO and CFO co-signing
-- a charter in one atomic act (which hides WHO authorized what), the CEO first
-- PROPOSES the ceilings; the charter only exists once the CFO independently
-- ACCEPTS. This is the real "why a CFO signs off" step — a two-party agreement,
-- on-ledger and non-repudiable.
template CharterProposal
  with
    ceo             : Party
    cfo             : Party
    treasurer       : Party
    regulator       : Party
    ceilingPerTxCap : Decimal
    ceilingBudget   : Decimal
  where
    signatory ceo
    observer cfo, treasurer, regulator

    ensure ceilingPerTxCap > 0.0 && ceilingBudget > 0.0

    choice AcceptByCfo : ContractId TreasuryCharter
      controller cfo
      do
        create TreasuryCharter with
          ceo, cfo, treasurer, regulator, ceilingPerTxCap, ceilingBudget

    choice RejectByCfo : ()
      controller cfo
      do pure ()

-- | The top authority layer. A TreasuryCharter is signed by BOTH the CEO and the
-- CFO (real multi-sig) and sets absolute ceilings. A treasurer can mint an
-- operational SpendMandate from it, but only one that TIGHTENS the ceilings —
-- never loosens them. The "child can only tighten the parent" invariant is
-- enforced by the ledger here (assertMsg), so it actually fires.
template TreasuryCharter
  with
    ceo             : Party
    cfo             : Party
    treasurer       : Party
    regulator       : Party
    ceilingPerTxCap : Decimal
    ceilingBudget   : Decimal
  where
    signatory ceo, cfo
    observer treasurer, regulator

    ensure ceilingPerTxCap > 0.0 && ceilingBudget > 0.0

    -- The treasurer mints an operational mandate within the chartered ceilings.
    -- NONCONSUMING: one charter can mint/re-mint many mandates over its life.
    nonconsuming choice MintMandate : ContractId SpendMandate
      with
        agent             : Party
        bank              : Party
        mandateId         : Text
        category          : Text
        perTxCap          : Decimal
        remainingBudget   : Decimal
        expiry            : Time
        approvedSuppliers : [Party]
        allowAutoCommit   : Bool
      controller treasurer
      do
        assertMsg "per-tx cap exceeds charter ceiling" (perTxCap <= ceilingPerTxCap)
        assertMsg "budget exceeds charter ceiling"     (remainingBudget <= ceilingBudget)
        -- Issuance invariant: never mint an already-impossible mandate whose
        -- per-tx cap is larger than its own budget. (Not an `ensure` on the
        -- mandate itself — a near-exhausted mandate after spends is legitimate.)
        assertMsg "per-tx cap exceeds budget at issuance" (perTxCap <= remainingBudget)
        create SpendMandate with
          treasurer
          agent
          bank
          regulator
          charterCeo = ceo
          charterCfo = cfo
          mandateId
          category
          perTxCap
          remainingBudget
          expiry
          approvedSuppliers
          allowAutoCommit

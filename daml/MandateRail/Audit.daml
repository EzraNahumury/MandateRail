module MandateRail.Audit where

-- | Immutable, on-chain audit of an authorized Commit. Signed by treasurer +
-- agent, observed by the regulator. It records the LEDGER's own precondition
-- verdicts — each boolean is DERIVED from the exact expression the Commit choice
-- asserts on, not hardcoded — plus an ADVISORY agent note.
--
-- It deliberately does NOT carry the per-tx cap or remaining budget: the
-- regulator audits WHAT was bought and that EVERY policy check passed, without
-- ever seeing the private financials. That is selective disclosure — the
-- auditor's read-only slice — and it is why the booleans (verdicts), not the
-- thresholds, are what's recorded.
template AuditRecord
  with
    treasurer        : Party
    agent            : Party
    regulator        : Party
    mandateId        : Text   -- human-readable lineage key (e.g. MANDATE-2026-001)
    category         : Text
    supplier         : Party
    amount           : Decimal
    underPerTxCap    : Bool
    underBudget      : Bool
    supplierApproved : Bool
    categoryMatch    : Bool
    notExpired       : Bool
    humanApproved    : Bool
    committedAt      : Time
    agentNote        : Text
  where
    signatory treasurer, agent
    observer regulator

-- | Append-only, regulator-observable proof that a mandate was KILLED — by whom,
-- under which authority layer, and why. Closes the gap where a silent Revoke left
-- no on-chain trace. It deliberately carries NO cap/budget: the regulator learns
-- the kill event and its reason, never the private financials (selective
-- disclosure, same as AuditRecord).
template RevocationRecord
  with
    mandateId : Text
    revokedBy : Party
    role      : Text    -- "treasurer" (operational kill) | "charter" (CEO+CFO cascade)
    reason    : Text
    regulator : Party
    at        : Time
  where
    signatory revokedBy
    observer regulator

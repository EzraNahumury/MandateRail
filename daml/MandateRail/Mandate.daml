module MandateRail.Mandate where

import MandateRail.Cash
import MandateRail.Rfq
import MandateRail.Purchase
import MandateRail.Audit

-- | Result of a successful Commit: the recreated mandate (reduced budget),
-- the binding purchase order, the cash now owned by the supplier, and the
-- immutable on-chain audit record.
data CommitResult = CommitResult with
    mandate       : ContractId SpendMandate
    purchaseOrder : ContractId PurchaseOrder
    cash          : ContractId Iou
    audit         : ContractId AuditRecord
  deriving (Eq, Show)

-- | The five ledger verdicts for a candidate spend. Computed by ONE function so
-- the SAME expression powers (a) the Commit preconditions, (b) the AuditRecord
-- evidence, and (c) the read-only DryRunCommit — they can never drift apart, and
-- none of them is hardcoded.
data Verdicts = Verdicts with
    underPerTxCap    : Bool
    underBudget      : Bool
    supplierApproved : Bool
    categoryMatch    : Bool
    notExpired       : Bool
  deriving (Eq, Show)

-- | The enforcement core. A treasurer issues a SpendMandate to a named agent.
-- Every limit (per-tx cap, cumulative budget, expiry, allow-list) is enforced
-- as a precondition of the Commit choice — by the ledger, not by app code or
-- a prompt. The agent (only an observer) can never see anything it is not a
-- stakeholder of, and can never act outside the encoded mandate.
template SpendMandate
  with
    treasurer         : Party
    agent             : Party
    bank              : Party
    regulator         : Party
    charterCeo        : Party
    charterCfo        : Party
    mandateId         : Text     -- human-readable lineage key (e.g. MANDATE-2026-001)
    category          : Text
    perTxCap          : Decimal
    remainingBudget   : Decimal
    expiry            : Time
    approvedSuppliers : [Party]
    allowAutoCommit   : Bool      -- capability dial: False => agent may ONLY escalate,
                                  -- never auto-spend (every buy needs treasurer sign-off)
  where
    signatory treasurer
    observer agent, charterCeo, charterCfo
    -- NOTE: the regulator is deliberately NOT an observer of the mandate, so the
    -- cap and remaining budget never reach its node (selective disclosure). The
    -- regulator only sees the PurchaseOrder + AuditRecord emitted by Commit.
    -- The chartering CEO + CFO ARE observers — they are the top authority layer.

    ensure perTxCap > 0.0 && remainingBudget >= 0.0

    -- Derive the verdicts for a candidate spend against THIS mandate.
    let verdictsFor (quote : RfqQuote) (amount : Decimal) (now : Time) = Verdicts with
          underPerTxCap    = amount <= perTxCap
          underBudget      = amount <= remainingBudget
          supplierApproved = quote.supplier `elem` approvedSuppliers
          categoryMatch    = quote.category == category
          notExpired       = now < expiry

    -- Agent commits a compliant purchase. CONSUMING (default): archives this
    -- mandate and recreates it with reduced remainingBudget (the anti-race
    -- mechanism). `cashCid` MUST be a treasury-owned Iou so that owner
    -- (treasurer) authority is in scope for the Transfer.
    choice Commit : CommitResult
      with
        quoteCid  : ContractId RfqQuote
        amount    : Decimal
        cashCid   : ContractId Iou
        agentNote : Text   -- advisory rationale, logged for audit; NEVER an authority
      controller agent
      do
        now   <- getTime
        quote <- fetch quoteCid

        -- LEDGER-ENFORCED POLICY (not app logic, not a prompt). The verdicts are
        -- derived once and reused as both precondition and audit evidence.
        let v = verdictsFor quote amount now
        -- Capability gate: a mandate minted without auto-commit authority can only
        -- ever escalate. The agent's autonomous spend is OFF unless the treasurer
        -- explicitly granted it at issuance.
        assertMsg "auto-commit not permitted by this mandate" allowAutoCommit
        assertMsg "amount exceeds per-tx cap"       v.underPerTxCap
        assertMsg "amount exceeds remaining budget" v.underBudget
        assertMsg "supplier not on allow-list"      v.supplierApproved
        assertMsg "category mismatch"               v.categoryMatch
        assertMsg "mandate expired"                 v.notExpired
        assertMsg "amount must match quoted price"  (amount == quote.price)

        -- Bring in the supplier's authority via their standing sealed offer.
        poCid <- exercise quoteCid Accept with buyerAgent = agent, regulator = regulator

        -- Settle tokenized cash (treasury-owned -> owner authority in scope).
        (paidCash, _change) <- exercise cashCid Transfer with
                                 newOwner       = quote.supplier
                                 transferAmount = amount

        -- Immutable, regulator-observable audit record — created INSIDE this one
        -- atomic transaction, so the rationale is provably tied to a real,
        -- ledger-validated spend. The booleans are the ledger's verdict (the
        -- authority); agentNote is advisory data only.
        auditCid <- create AuditRecord with
          treasurer, agent, regulator, mandateId
          category, supplier = quote.supplier, amount
          underPerTxCap = v.underPerTxCap, underBudget = v.underBudget
          supplierApproved = v.supplierApproved, categoryMatch = v.categoryMatch
          notExpired = v.notExpired
          humanApproved = False
          committedAt = now
          agentNote

        -- Archive-and-recreate: contention-safe cumulative cap.
        newMandate <- create this with remainingBudget = remainingBudget - amount

        pure CommitResult with
          mandate       = newMandate
          purchaseOrder = poCid
          cash          = paidCash
          audit         = auditCid

    -- Human-in-the-loop override. The agent CANNOT exceed the per-tx cap — but a
    -- TREASURER who has reviewed an escalation can authorize a single over-cap
    -- buy. Every other policy (budget, allow-list, category, expiry) still fires,
    -- and the audit records underPerTxCap=false + humanApproved=true (honest).
    -- Note: allowAutoCommit is intentionally NOT checked here — a treasurer-signed
    -- approval is exactly the authority a no-auto-commit mandate routes through.
    choice CommitApproved : CommitResult
      with
        quoteCid  : ContractId RfqQuote
        amount    : Decimal
        cashCid   : ContractId Iou
        agentNote : Text
      -- treasurer + agent co-authorize: the agent alone can NEVER over-spend; only
      -- a treasurer approval (which carries agent authority via the request) does.
      controller treasurer, agent
      do
        now   <- getTime
        quote <- fetch quoteCid

        let v = verdictsFor quote amount now
        -- per-tx cap is NOT asserted here — the treasurer is approving an override
        assertMsg "amount exceeds remaining budget" v.underBudget
        assertMsg "supplier not on allow-list"      v.supplierApproved
        assertMsg "category mismatch"               v.categoryMatch
        assertMsg "mandate expired"                 v.notExpired
        assertMsg "amount must match quoted price"  (amount == quote.price)

        poCid <- exercise quoteCid Accept with buyerAgent = agent, regulator = regulator
        (paidCash, _change) <- exercise cashCid Transfer with
                                 newOwner = quote.supplier, transferAmount = amount

        auditCid <- create AuditRecord with
          treasurer, agent, regulator, mandateId
          category, supplier = quote.supplier, amount
          underPerTxCap = v.underPerTxCap, underBudget = v.underBudget
          supplierApproved = v.supplierApproved, categoryMatch = v.categoryMatch
          notExpired = v.notExpired
          humanApproved = True
          committedAt = now
          agentNote

        newMandate <- create this with remainingBudget = remainingBudget - amount

        pure CommitResult with
          mandate = newMandate, purchaseOrder = poCid, cash = paidCash, audit = auditCid

    -- Read-only pre-flight. Returns the SAME ledger verdicts a Commit would assert
    -- on, WITHOUT spending — so the UI's rule-lights are sourced from the ledger
    -- itself, never re-implemented in TypeScript. NONCONSUMING: the mandate is
    -- untouched. The agent can ask "would this pass?" before committing.
    nonconsuming choice DryRunCommit : [(Text, Bool)]
      with
        quoteCid : ContractId RfqQuote
        amount   : Decimal
      controller agent
      do
        now   <- getTime
        quote <- fetch quoteCid
        let v = verdictsFor quote amount now
        pure
          [ ("autoCommitAllowed", allowAutoCommit)
          , ("underPerTxCap",     v.underPerTxCap)
          , ("underBudget",       v.underBudget)
          , ("supplierApproved",  v.supplierApproved)
          , ("categoryMatch",     v.categoryMatch)
          , ("notExpired",        v.notExpired)
          , ("priceMatches",      amount == quote.price)
          ]

    -- Instant kill switch. CONSUMING (default): archives the mandate, so the
    -- agent's next Commit fails because its input contract no longer exists.
    -- Now emits an append-only RevocationRecord (who/why), visible to the
    -- regulator — revocation is no longer a silent, untraceable act.
    choice Revoke : ContractId RevocationRecord
      with
        reason : Text
      controller treasurer
      do
        now <- getTime
        create RevocationRecord with
          mandateId, revokedBy = treasurer, role = "treasurer", reason, regulator, at = now

    -- Top-layer kill switch: the CEO + CFO who chartered this mandate can revoke
    -- it (real multi-sig). Archiving the mandate makes the agent's next Commit
    -- fail — a cascade from the authority layer above, and it actually fires.
    -- Also audited via RevocationRecord (role = "charter").
    choice RevokeByCharter : ContractId RevocationRecord
      with
        reason : Text
      controller charterCeo, charterCfo
      do
        now <- getTime
        create RevocationRecord with
          mandateId, revokedBy = charterCeo, role = "charter", reason, regulator, at = now

module MandateRail.Bootstrap where

import DA.Time (hours, addRelTime)
import Daml.Script

import MandateRail.Cash
import MandateRail.Mandate
import MandateRail.Rfq
import MandateRail.Charter

-- | Init script for `daml start`. Allocates the demo parties, funds the
-- treasury, issues the mandate, and seeds three sealed quotes.
setup : Script ()
setup = do
  treasurer <- allocateParty "Treasurer"
  agent     <- allocateParty "BuyerAgent"
  bank      <- allocateParty "Bank"
  supA      <- allocateParty "SupplierA"
  supB      <- allocateParty "SupplierB"
  supC      <- allocateParty "SupplierC"
  supD      <- allocateParty "SupplierD"
  regulator <- allocateParty "Regulator"
  ceo       <- allocateParty "CEO"
  cfo       <- allocateParty "CFO"

  now <- getTime
  let expiry = addRelTime now (hours (24 * 30)) -- 30 days

  -- Treasury cash (owned by the treasurer, earmarked/disclosed to the agent
  -- so Commit can settle it without the agent ever owning it).
  _cash <- submit bank do
    createCmd Iou with bank = bank, owner = treasurer, amount = 50000.0, observers = [agent], releaser = None

  -- LAYER 1 — GOVERNANCE: the CEO proposes ceilings; the charter only exists once
  -- the CFO independently accepts (the visible two-party multi-sig moment).
  proposal <- submit ceo do
    createCmd CharterProposal with
      ceo = ceo
      cfo = cfo
      treasurer = treasurer
      regulator = regulator
      ceilingPerTxCap = 15000.0
      ceilingBudget = 100000.0
  charter <- submit cfo do exerciseCmd proposal AcceptByCfo

  -- LAYER 2 — a PORTFOLIO of operational mandates, all minted WITHIN the one
  -- $100k charter ceiling (50k + 30k + 20k = 100k) and each tighter on per-tx
  -- cap — a real treasury delegation across spend categories, not a single toy.
  _mCloud <- submit treasurer do
    exerciseCmd charter MintMandate with
      agent = agent
      bank = bank
      mandateId = "MANDATE-2026-001"
      category = "cloud-compute"
      perTxCap = 10000.0
      remainingBudget = 50000.0
      expiry = expiry
      approvedSuppliers = [supA, supB, supC]
      allowAutoCommit = True
  _mFreight <- submit treasurer do
    exerciseCmd charter MintMandate with
      agent = agent, bank = bank, mandateId = "MANDATE-2026-002", category = "freight"
      perTxCap = 8000.0, remainingBudget = 30000.0, expiry = expiry
      approvedSuppliers = [supA, supB], allowAutoCommit = True
  _mAds <- submit treasurer do
    exerciseCmd charter MintMandate with
      agent = agent, bank = bank, mandateId = "MANDATE-2026-003", category = "ad-inventory"
      perTxCap = 5000.0, remainingBudget = 20000.0, expiry = expiry
      approvedSuppliers = [supB, supC], allowAutoCommit = False  -- ads: escalate-only

  -- Sealed quotes from the approved suppliers.
  _qA <- submit supA do
    createCmd RfqQuote with supplier = supA, agent = agent, category = "cloud-compute", price = 9000.0
  _qB <- submit supB do
    createCmd RfqQuote with supplier = supB, agent = agent, category = "cloud-compute", price = 9500.0
  _qC <- submit supC do
    createCmd RfqQuote with supplier = supC, agent = agent, category = "cloud-compute", price = 9200.0

  -- Demo quotes for the negative paths (money-shot #1):
  --  * SupplierD is NOT on the allow-list  -> Commit must be rejected
  --  * SupplierC's 12k quote is OVER the per-tx cap -> Commit must be rejected
  _qOffList <- submit supD do
    createCmd RfqQuote with supplier = supD, agent = agent, category = "cloud-compute", price = 9000.0
  _qOverCap <- submit supC do
    createCmd RfqQuote with supplier = supC, agent = agent, category = "cloud-compute", price = 12000.0

  pure ()

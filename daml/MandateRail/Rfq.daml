module MandateRail.Rfq where

import MandateRail.Cash
import MandateRail.Purchase

-- | Sealed-bid quote. Signatory is the supplier; the ONLY observer is the
-- buyer agent. Rival suppliers are never observers, so a quote never reaches
-- a competitor's node — this is the sealed-bid privacy property.
template RfqQuote
  with
    supplier : Party
    agent    : Party
    category : Text
    price    : Decimal
  where
    signatory supplier
    observer agent

    ensure price > 0.0

    -- Consuming: a quote is single-use (no replay). Exercising this
    -- supplier-signed choice contributes the supplier's authority, which is
    -- what lets the agent + supplier co-sign the resulting PurchaseOrder.
    --
    -- Controlled by buyerAgent AND treasurer: the treasurer's authority is only
    -- in scope inside Commit (it flows from the SpendMandate signatory), so the
    -- agent CANNOT mint a bare PurchaseOrder on its own — every PO is the product
    -- of a real, budget-debited Commit. `escrowCid` is the bank-held payment the
    -- Commit just locked, so the PO is funded-but-pending-delivery from birth.
    choice Accept : ContractId PurchaseOrder
      with
        buyerAgent : Party
        treasurer  : Party
        regulator  : Party
        escrowCid  : ContractId Iou
      controller buyerAgent, treasurer
      do
        create PurchaseOrder with
          agent     = buyerAgent
          supplier  = supplier
          regulator = regulator
          category  = category
          amount    = price
          status    = "FUNDED_PENDING_DELIVERY"
          escrow    = escrowCid
